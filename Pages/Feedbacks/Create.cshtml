@page
@model Licenta.Pages.Feedbacks.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Lasă-ne un feedback !</h1>

<h4>Feedback</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="RezervareId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Feedback.Rating" class="control-label"></label>

                <select asp-for="Feedback.Rating" class="form-select">
                    <option value="">Selectează rating</option>
                    <option value="1">1 - Foarte slab</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5 - Excelent</option>
                </select>
                <span asp-validation-for="Feedback.Rating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Feedback.Comentariu" class="control-label"></label>
                <textarea asp-for="Feedback.Comentariu"
                          class="form-control"
                          rows="5"></textarea>
                <span asp-validation-for="Feedback.Comentariu" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
