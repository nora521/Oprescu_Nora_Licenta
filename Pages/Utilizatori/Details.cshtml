@page
@model Licenta.Pages.Utilizatori.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Detalii</h1>

<div>
    <h4>Utilizator</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizator.Nume)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.Nume)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizator.Prenume)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.Prenume)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizator.CNP)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.CNP)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizator.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizator.NrTelefon)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.NrTelefon)
        </dd>
        <dt class="col-sm-2">
            Permis verificat
        </dt>
        <dd class="col-sm-10">
            @(Model.Utilizator.PermisVerificat ? "Da" : "Nu")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizator.SeriePermis)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.SeriePermis)
        </dd>
        <dt class="col-sm-2">
            Categorii permis
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.CategoriiPermis)
        </dd>
        <dt class="col-sm-2">
            Data emitere permis
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.DataEmiterePermis)
        </dd>

        <dt class="col-sm-2">
            Data expirare permis
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.DataExpirarePermis)
        </dd>

        <dt class="col-sm-2">
            Data nașterii
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizator.DataNasterii)
        </dd>

    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Utilizator.ID" class="btn btn-primary">Editare</a> |
    <a asp-page="./Index" class="btn btn-primary">Înapoi</a>
</div>
