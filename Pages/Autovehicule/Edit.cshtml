@page
@model Licenta.Pages.Autovehicule.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editare</h1>

<h4>Autovehicul</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Autovehicul.ID" />
            <div class="form-group">
                <label asp-for="Autovehicul.MarcaID" class="control-label">Marca</label>
                <select asp-for="Autovehicul.MarcaID" class="form-control" asp-items="ViewBag.MarcaID">
                </select>
                <span asp-validation-for="Autovehicul.MarcaID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.Model" class="control-label"></label>
                <input asp-for="Autovehicul.Model" class="form-control" />
                <span asp-validation-for="Autovehicul.Model" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.SerieSasiu" class="control-label"></label>
                <input asp-for="Autovehicul.SerieSasiu" class="form-control" />
                <span asp-validation-for="Autovehicul.SerieSasiu" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.NrInmatriculare" class="control-label"></label>
                <input asp-for="Autovehicul.NrInmatriculare" class="form-control" />
                <span asp-validation-for="Autovehicul.NrInmatriculare" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.CombustibilID" class="control-label">Combustibil</label>
                <select asp-for="Autovehicul.CombustibilID" class="form-control" asp-items="ViewBag.CombustibilID">
                </select>
                <span asp-validation-for="Autovehicul.CombustibilID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.TransmisieID" class="control-label">Transmisie</label>
                <select asp-for="Autovehicul.TransmisieID" class="form-control" asp-items="ViewBag.TransmisieID">
                </select>
                <span asp-validation-for="Autovehicul.TransmisieID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.NrLocuri" class="control-label"></label>
                <input asp-for="Autovehicul.NrLocuri" class="form-control" />
                <span asp-validation-for="Autovehicul.NrLocuri" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.NrBagaje" class="control-label"></label>
                <input asp-for="Autovehicul.NrBagaje" class="form-control" />
                <span asp-validation-for="Autovehicul.NrBagaje" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.PretZi" class="control-label"></label>
                <input asp-for="Autovehicul.PretZi" class="form-control" />
                <span asp-validation-for="Autovehicul.PretZi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.Kilometraj" class="control-label"></label>
                <input asp-for="Autovehicul.Kilometraj" class="form-control" />
                <span asp-validation-for="Autovehicul.Kilometraj" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.ConsumMixt" class="control-label"></label>
                <input asp-for="Autovehicul.ConsumMixt" class="form-control" />
                <span asp-validation-for="Autovehicul.ConsumMixt" class="text-danger"></span>
            </div>
            <div class="form-group">
    <div class="table">
        <table>
            <tr>
                @{
                    int cnt = 0;

                    foreach (var cat in Model.AssignedCategoryDataList)
                    {
                        if (cnt++ % 3 == 0)
                        {
                            @:</tr><tr>
                        }

                        @:<td>
                            <input type="checkbox"
                                   name="selectedCategories"
                                   value="@cat.CategoryID"
                                   @(Html.Raw(cat.Assigned ? "checked=\"checked\"" : "")) />
                            @cat.CategoryID @: @cat.Nume
                        @:</td>
                    }
                    @:</tr>
                }
        </table>
    </div>
</div>

            <div class="form-group">
                <label asp-for="Autovehicul.AnFabricatie" class="control-label"></label>
                <input asp-for="Autovehicul.AnFabricatie" class="form-control" />
                <span asp-validation-for="Autovehicul.AnFabricatie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.Culoare" class="control-label"></label>
                <input asp-for="Autovehicul.Culoare" class="form-control" />
                <span asp-validation-for="Autovehicul.Culoare" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.CP" class="control-label"></label>
                <input asp-for="Autovehicul.CP" class="form-control" />
                <span asp-validation-for="Autovehicul.CP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.CMC" class="control-label"></label>
                <input asp-for="Autovehicul.CMC" class="form-control" />
                <span asp-validation-for="Autovehicul.CMC" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.DataITP" class="control-label"></label>
                <input asp-for="Autovehicul.DataITP" class="form-control" />
                <span asp-validation-for="Autovehicul.DataITP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.DataRCA" class="control-label"></label>
                <input asp-for="Autovehicul.DataRCA" class="form-control" />
                <span asp-validation-for="Autovehicul.DataRCA" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.DataRovinieta" class="control-label"></label>
                <input asp-for="Autovehicul.DataRovinieta" class="form-control" />
                <span asp-validation-for="Autovehicul.DataRovinieta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.DataRevizie" class="control-label"></label>
                <input asp-for="Autovehicul.DataRevizie" class="form-control" />
                <span asp-validation-for="Autovehicul.DataRevizie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Autovehicul.UtilizatorID" class="control-label">Utilizator</label>
                <select asp-for="Autovehicul.UtilizatorID" class="form-control" asp-items="ViewBag.UtilizatorID">
                </select>
                <span asp-validation-for="Autovehicul.UtilizatorID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Salvare" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index" class="btn btn-primary">Înapoi</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
