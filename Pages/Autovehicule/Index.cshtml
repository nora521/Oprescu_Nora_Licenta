@page 

@model Licenta.Pages.Autovehicule.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Autovehicule</h1>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Adaugă Vehicul
        </a>
    }
</p>
<form asp-page="./Index" method="get" class="mb-3">
    <div class="form-actions no-color d-flex align-items-center gap-2">

        <span>Căutare:</span>

        <input type="text"
               name="searchString"
               value="@Request.Query["searchString"]" />

        <input type="submit" value="Căutare" class="btn btn-primary ms-2" />

        @if (!User.IsInRole("Admin"))
        {
            <label class="form-label mb-0 ms-2">Categorie:</label>
            <select name="categoryID"
                    asp-items="ViewBag.CategoryID"
                    class="form-control"
                    style="width: 200px"
                    onchange="this.form.submit()">
                <option value="">Toate categoriile</option>
            </select>

            <script>
                        document.querySelector('select[name="categoryID"]').value =
                            "@Request.Query["categoryID"]";
            </script>

            <label class="form-label mb-0 ms-2">Sortare preț:</label>
            <select name="sortOrder"
                    class="form-control"
                    style="width: 180px"
                    onchange="this.form.submit()">
                <option value="">Fără sortare</option>
                <option value="price_asc">Preț crescător</option>
                <option value="price_desc">Preț descrescător</option>
            </select>

            <script>
                        document.querySelector('select[name="sortOrder"]').value =
                            "@Request.Query["sortOrder"]";
            </script>
        }

        <a asp-page="./Index" class="btn btn-primary">Înapoi</a>
    </div>
</form>




<table class="table">
    <thead>
        <tr>
            <th> 
                
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].Marca.NumeMarca)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].Model)
            </th>
            @if (!User.IsInRole("Admin"))
            {
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].Combustibil.TipCombustibil)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].Transmisie.TipTransmisie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].NrLocuri)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].NrBagaje)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].PretZi)
            </th>
            }
            @if (User.IsInRole("Admin"))
            {
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].SerieSasiu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].NrInmatriculare)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].Kilometraj)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].DataITP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].DataRCA)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].DataRovinieta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autovehicul[0].DataRevizie)
            </th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Autovehicul) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.Poza)
                    <img src="~/images/@(item.Model.ToLower()).jpg"
                         style="border-radius: 12px; border: 3px solid #001f3f; max-height: 170px; object-fit: cover;" />

            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Marca.NumeMarca)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Model)
            </td>
            @if(!User.IsInRole("Admin"))
            {
                <td>
                    @Html.DisplayFor(modelItem => item.Combustibil.TipCombustibil)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Transmisie.TipTransmisie)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NrLocuri)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NrBagaje)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PretZi)
                </td>
                }
                @if (User.IsInRole("Admin"))
                {
            <td>
                @Html.DisplayFor(modelItem => item.SerieSasiu)
            </td>
                
            <td>
                @Html.DisplayFor(modelItem => item.NrInmatriculare)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kilometraj)
            </td>
                <td style="@(item.DataITP.Date <= DateTime.Now.Date.AddDays(7) && item.DataITP.Date >= DateTime.Now.Date ? "background-color: #ffdce0; color: #b32424; font-weight: bold;" : "")">
                @Html.DisplayFor(modelItem => item.DataITP)
            </td>
                <td style="@(item.DataRCA.Date <= DateTime.Now.Date.AddDays(7) && item.DataRCA.Date >= DateTime.Now.Date ? "background-color: #ffdce0; color: #b32424; font-weight: bold;" : "")">
                 @Html.DisplayFor(modelItem => item.DataRCA)
            </td>
                <td style="@(item.DataRovinieta.Date <= DateTime.Now.Date.AddDays(7) && item.DataRovinieta.Date >= DateTime.Now.Date ? "background-color:  #ffdce0; color: #b32424; font-weight: bold;" : "")">
                 @Html.DisplayFor(modelItem => item.DataRovinieta)
            </td>

                <td style="@(item.DataRevizie.Date <= DateTime.Now.Date.AddDays(7) && item.DataRevizie.Date >= DateTime.Now.Date ? "background-color:  #ffdce0; color: #b32424; font-weight: bold;" : "")">
                 @Html.DisplayFor(modelItem => item.DataRevizie)
            </td>
                
            <td>
                    <a asp-page-handler="ExportPdf" asp-route-id="@item.ID" class="btn btn-navy-outline-icon" target="_blank"><i class="bi bi-file-earmark-pdf me-2"></i> Export PDF </a>
                    <a asp-page="./Details" asp-route-id="@item.ID" class="btn btn-outline-navy btn-sm px-3 mx-1">
                        <i class="bi bi-eye"></i> Detalii
                    </a>
                        <a asp-page="./Edit" asp-route-id="@item.ID" class="btn btn-outline-navy btn-sm px-3">
                            <i class="bi bi-pencil"></i> Editare
                        </a>
                        <a asp-page="./Delete" asp-route-id="@item.ID" class="btn btn-outline-danger btn-sm px-3">
                            <i class="bi bi-trash"></i> Ștergere
                        </a>                   
            </td>
                    }
                @if (User.IsInRole("User"))
                {
                    <td>
                    <a class="btn btn-primary"
                           asp-area="@(User.Identity.IsAuthenticated ? "" : "Identity")"
                           asp-page="@(User.Identity.IsAuthenticated ? "/Rezervari/Create" : "/Account/Login")"
                           asp-route-autovehiculId="@(User.Identity.IsAuthenticated? item.ID: null)">
                        Rezervă
                    </a>

                </td>
                }
        </tr>
}
    </tbody>
</table>



